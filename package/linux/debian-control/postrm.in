#!/bin/sh
# AIR Studio Server postrm
if ps -p1 | grep systemd > /dev/null 2>&1; then
   systemctl stop air-studio-server.service 2>/dev/null
   systemctl disable air-studio-server.service 2>/dev/null
   rm -rf /lib/systemd/system/air-studio-server.service
   rm -rf /usr/lib/systemd/system/air-studio-server.service
else
   /etc/init.d/air-studio-server stop 2>/dev/null
   update-rc.d air-studio-server remove 2>/dev/null
   rm -f /etc/init.d/air-studio-server
fi
rm -f /usr/sbin/air-studio-server
