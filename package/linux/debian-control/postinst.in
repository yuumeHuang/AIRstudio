#!/bin/sh
# AIR Studio Server postinst — installs alongside (not over) Posit RStudio.
# Everything lives under air-studio names; no rstudio-server paths touched.
set +e

# service user
useradd -r -U air-studio 2>/dev/null

# admin CLI symlink
ln -f -s ${CMAKE_INSTALL_PREFIX}/bin/air-studio-server /usr/sbin/air-studio-server

# config dir + defaults
mkdir -p /etc/air-studio
if ! test -f /etc/air-studio/rserver.conf
then
  sh -c "printf '# AIR Studio Server Configuration File\n\n' > /etc/air-studio/rserver.conf"
fi
if ! test -f /etc/air-studio/rsession.conf
then
  sh -c "echo '# R Session Configuration File\n\n' > /etc/air-studio/rsession.conf"
fi
if ! test -f /etc/air-studio/database.conf
then
  cp ${CMAKE_INSTALL_PREFIX}/extras/conf/database.conf /etc/air-studio/
  chown air-studio /etc/air-studio/database.conf
  chmod 600 /etc/air-studio/database.conf
fi
mkdir -p /etc/air-studio/themes /etc/air-studio/fonts
cp -n ${CMAKE_INSTALL_PREFIX}/extras/themes/README.md /etc/air-studio/themes/ 2>/dev/null
cp -n ${CMAKE_INSTALL_PREFIX}/extras/fonts/README.md /etc/air-studio/fonts/ 2>/dev/null

# PAM profile (service name "air-studio", see PamMain.cpp)
if ! test -f /etc/pam.d/air-studio
then
  cp ${CMAKE_INSTALL_PREFIX}/extras/pam/air-studio /etc/pam.d/air-studio
fi

# runtime dirs
mkdir -p /var/run/air-studio-server
mkdir -p /var/lock/air-studio-server
mkdir -p /var/log/air-studio
mkdir -p /var/lib/air-studio-server
mkdir -p /var/lib/air-studio-server/conf
mkdir -p /var/lib/air-studio-server/body
mkdir -p /var/lib/air-studio-server/proxy

# install systemd unit and start
if ps -p1 | grep systemd > /dev/null 2>&1; then
   systemctl stop air-studio-server.service 2>/dev/null
   if test -e /lib/systemd
   then
      SYSTEMD_PREFIX="/lib/systemd"
   else
      SYSTEMD_PREFIX="/usr/lib/systemd"
   fi
   cp ${CMAKE_INSTALL_PREFIX}/extras/systemd/air-studio-server.service $SYSTEMD_PREFIX/system/
   systemctl daemon-reload
   systemctl enable air-studio-server.service
   /usr/sbin/air-studio-server start
   sleep 1
   systemctl --no-pager status air-studio-server.service
else
   cp ${CMAKE_INSTALL_PREFIX}/extras/init.d/debian/air-studio-server /etc/init.d/
   chmod +x /etc/init.d/air-studio-server
   update-rc.d air-studio-server defaults
   /etc/init.d/air-studio-server stop 2>/dev/null
   /usr/sbin/air-studio-server start
fi

set -e
