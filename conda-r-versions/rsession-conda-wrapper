#!/usr/bin/env bash
# rsession-conda-wrapper: rsession launcher that selects the user's chosen
# conda R environment, installed as rserver.conf rsession-path.
#
# rserver always launches rsession with the globally configured R; per-user
# environment switching (public conda envs + each user's personal ones) is
# implemented here. The SessionREnvs rsession module persists the user's
# choice on the active session (properites/r-version-home) and in the
# user-level default (rversion-settings/defaultRVersionHome); this wrapper
# reads it and starts rsession against that R.
#
# Resolution order:
#   1. most recent active session's properites/r-version-home (per-session)
#   2. user default rversion-settings/defaultRVersionHome (new sessions)
#   3. rserver-provided environment (system R)
set -u

RSESSION=/usr/lib/air-studio/bin/rsession

user=""
prev=""
for a in "$@"; do
   case "$a" in
      -u) prev="u" ; continue ;;
      -u?*) user="${a#-u}" ; break ;;
      *) if [ "$prev" = "u" ]; then user="$a"; break; fi ;;
   esac
done

rhome=""
if [ -n "$user" ]; then
   home="/home/$user"
   sd=$(ls -1dt "$home"/.local/share/rstudio/sessions/active/session-*/ 2>/dev/null | head -1)
   if [ -n "${sd:-}" ] && [ -f "$sd/properites/r-version-home" ]; then
      rh=$(cat "$sd/properites/r-version-home" 2>/dev/null)
      [ -d "$rh" ] && rhome="$rh"
   fi
   if [ -z "$rhome" ] && [ -f "$home/.local/share/air-studio/rversion-settings/defaultRVersionHome" ]; then
      rh=$(cat "$home/.local/share/air-studio/rversion-settings/defaultRVersionHome" 2>/dev/null)
      [ -d "$rh" ] && rhome="$rh"
   fi
fi

if [ -n "$rhome" ] && [ "$rhome" != "${R_HOME:-}" ] && [ -f "$rhome/lib/libR.so" ]; then
   export RSTUDIO_SYSTEM_R_HOME="${R_HOME:-}"
   export R_HOME="$rhome"
   export LD_LIBRARY_PATH="$rhome/lib:${LD_LIBRARY_PATH:-}"
fi

logger -t rsession-wrapper "user=$user rhome=$rhome"
exec "$RSESSION" "$@"
