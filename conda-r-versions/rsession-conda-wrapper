#!/usr/bin/env bash
# AIR Studio rsession launcher: selects the user's chosen conda R
# environment. Installed as /usr/lib/air-studio/bin/rsession-conda-wrapper
# and referenced by /etc/air-studio/rserver.conf (rsession-path).
#
# The user's choice is persisted by the SessionREnvs rsession module:
#   1. most recent active session's properites/r-version-home (per-session)
#   2. user default rversion-settings/defaultRVersionHome (new sessions)
#   3. rserver-provided environment (system R)
# All user state lives under ~/.local/share/air-studio (AIR Studio XDG dir).
set -u
RSESSION=/usr/lib/air-studio/bin/rsession
user=""
prev=""
for a in "$@"; do
   case "$a" in
      -u) prev="u" ; continue ;;
      -u?*) user="${a#-u}" ; break ;;
      *) if [ "$prev" = "u" ]; then user="$a"; break; fi ;;
   esac
done
rhome=""
if [ -n "$user" ]; then
   # resolve the home directory via passwd: it may live outside /home
   # (e.g. /home-ssd on nv) and hardcoding /home/$user silently broke
   # environment switching for such users
   home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
   if [ -z "$home" ] || [ ! -d "$home" ]; then
      home="/home/$user"
   fi
   sd=$(ls -1dt "$home"/.local/share/air-studio/sessions/active/session-*/ 2>/dev/null | head -1)
   if [ -n "${sd:-}" ] && [ -f "$sd/properites/r-version-home" ]; then
      rh=$(cat "$sd/properites/r-version-home" 2>/dev/null)
      [ -d "$rh" ] && rhome="$rh"
   fi
   if [ -z "$rhome" ] && [ -f "$home/.local/share/air-studio/rversion-settings/defaultRVersionHome" ]; then
      rh=$(cat "$home/.local/share/air-studio/rversion-settings/defaultRVersionHome" 2>/dev/null)
      [ -d "$rh" ] && rhome="$rh"
   fi
fi
if [ -n "$rhome" ] && [ "$rhome" != "${R_HOME:-}" ] && [ -f "$rhome/lib/libR.so" ]; then
   export RSTUDIO_SYSTEM_R_HOME="${R_HOME:-}"
   export R_HOME="$rhome"
   export LD_LIBRARY_PATH="$rhome/lib:${LD_LIBRARY_PATH:-}"
fi
logger -t air-studio-rsession-wrapper "user=$user rhome=$rhome"
exec "$RSESSION" "$@"
