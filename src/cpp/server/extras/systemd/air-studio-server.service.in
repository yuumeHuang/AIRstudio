[Unit]
Description=AIR Studio Server
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/air-studio-server.pid
ExecStart=${CMAKE_INSTALL_PREFIX}/bin/rserver
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/etc/default/air-studio-server
Restart=on-failure

[Install]
WantedBy=multi-user.target
